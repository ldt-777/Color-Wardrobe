{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "android",
    "ios",
    ".test-build",
    // I test girano su Node e vengono controllati da tsconfig.test.json, che e'
    // l'unico a caricare i tipi di Node: da qui restano fuori.
    "**/*.test.ts"
  ]
}
