{
  // I test del motore colore girano su Node, non su Metro: qui compiliamo il
  // solo `src/color` in CommonJS, cosi' `node --test` puo' eseguirlo senza
  // bundler ne dispositivo.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node10",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "src/color/**/*.ts",
    // Di `src/i18n` prendiamo solo le parti pure: `index.ts` espone l'hook e
    // quindi importa React e il modulo nativo della localizzazione.
    "src/i18n/format.ts",
    "src/i18n/translations.ts",
    "src/i18n/i18n.test.ts",
    "src/types/**/*.d.ts"
  ]
}
