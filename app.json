{
  "expo": {
    "name": "Color Wardrobe",
    "slug": "color-wardrobe",
    "scheme": "colorwardrobe",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBFAF8",
      "dark": {
        "backgroundColor": "#0E0E10"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.colorwardrobe.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Serve la fotocamera per fotografare i tuoi capi e leggerne i colori.",
        "NSPhotoLibraryUsageDescription": "Serve la galleria per importare foto di capi gia' scattate."
      }
    },
    "android": {
      "package": "com.colorwardrobe.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#FBFAF8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Serve la fotocamera per fotografare i tuoi capi e leggerne i colori.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Serve la galleria per importare foto di capi gia' scattate."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBFAF8",
          "dark": { "backgroundColor": "#0E0E10" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
